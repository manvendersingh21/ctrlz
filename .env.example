# ctrlz environment variables
#
# EVERY variable here is optional. With none of them set, ctrlz runs fully
# keyless: a deterministic hashing embedder replaces real embeddings and a
# heuristic rules engine replaces the LLM. Keys upgrade quality, they are
# never required to boot.
#
# Copy to `.env` and uncomment what you need. `docker compose up` picks this
# file up automatically for the `app` service.

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------

# Connection string of the main cluster.
# Local atlas-local container (default): mongodb://localhost:27017/?directConnection=true
# Inside docker-compose:               mongodb://atlas:27017/?directConnection=true
# Atlas cloud:                         mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true
#MONGODB_URI=

# Separate connection string using a *grader principal* — a DB user that can
# only read the held-out eval database (`<MONGODB_DB>_eval`). Leave empty to
# run both roles over the same connection (local dev / atlas-local).
#MONGODB_GRADER_URI=

# Database name (defaults to "ctrlz"). The eval split lives in "<db>_eval".
#MONGODB_DB=ctrlz

# ---------------------------------------------------------------------------
# Embeddings & retrieval
# ---------------------------------------------------------------------------

# Embedding provider: "voyage" | "nvidia" | "hash".
# Auto-detected if unset: voyage when VOYAGE_API_KEY is set, nvidia when
# NVIDIA_API_KEY is set, otherwise the offline hash embedder.
#EMBED_PROVIDER=

# Voyage AI API key (https://dash.voyageai.com). Enables real embeddings AND
# reranking in hybrid retrieval.
#VOYAGE_API_KEY=

# Voyage embedding model (default: voyage-3.5).
#VOYAGE_MODEL=voyage-3.5

# Base URL for the Voyage API. Keys starting with "al-" are MongoDB Atlas
# Voyage keys and are routed to https://ai.mongodb.com/v1 automatically;
# override only for proxies/self-hosting.
#VOYAGE_BASE_URL=https://api.voyageai.com/v1

# Voyage rerank model used in the hybrid retrieval pipeline (default: rerank-2.5-lite).
#VOYAGE_RERANK_MODEL=rerank-2.5-lite

# NVIDIA API key (https://build.nvidia.com). Enables the NVIDIA NIM embedding
# fallback provider and doubles as the default LLM_API_KEY if that is unset.
#NVIDIA_API_KEY=

# ---------------------------------------------------------------------------
# LLM (any OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------

# OpenAI-compatible base URL (default: https://integrate.api.nvidia.com/v1).
#LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# API key for the LLM endpoint (falls back to NVIDIA_API_KEY). Without a key
# the deterministic heuristic engine is used.
#LLM_API_KEY=
# Or just set OPENAI_API_KEY: uses https://api.openai.com/v1 with gpt-4.1-mini (fast parallel tool calls).
#OPENAI_API_KEY=

# Model name (default: openai/gpt-oss-20b).
#LLM_MODEL=openai/gpt-oss-20b

# Per-request timeout in milliseconds (default: 25000).
#LLM_TIMEOUT_MS=25000

# Set to "1" to force the heuristic LLM even when a key is configured
# (useful for reproducible runs / tests).
#LLM_DISABLED=

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------

# Stripe test-mode key only. Live keys are refused by the app.
STRIPE_SECRET_KEY=

# Raindrop (raindrop.ai) — agent monitoring. Every agent turn, tool call, self-diagnostic, incident,
# compensation and clean replay is reported. Without a key, payloads are still mirrored to the
# `raindrop_events` collection and shown on the dashboard's Raindrop tab.
#RAINDROP_WRITE_KEY=
# Optional project slug when your Raindrop org has several projects.
#RAINDROP_PROJECT_ID=
# Optional local Raindrop Workshop URL (e.g. http://localhost:5899/v1/); used when there is no write key.
#RAINDROP_WORKSHOP=
# Set to 1 to have the SDK redact PII (emails etc.) before sending. Off by default so the attack evidence
# (Mallory's cc address, card last-4) is visible; ctrlz never stores full card numbers (guardrail blocks them).
#RAINDROP_REDACT_PII=0
# Optional build revision attached to every event.
#RAINDROP_COMMIT_SHA=

# MongoDB Agent Engine (operational tracing of agents & tools).
#AGENT_ENGINE_API_KEY=
#AGENT_ENGINE_PROJECT_ID=
#AGENT_ENGINE_BASE_URL=https://agentengine.mongodb.com

# ---------------------------------------------------------------------------
# Hardening
# ---------------------------------------------------------------------------

# HTTP Basic Auth credential as "user:pass". When set, EVERY route except
# /api/health requires authentication (including the dashboard itself).
# Unset = no auth (local dev only).
#CTRLZ_BASIC_AUTH=

# 1 (default) allows POST /api/reset to wipe & reseed the world.
# Set to 0 to disable resetting — recommended for any shared deployment.
#CTRLZ_ALLOW_RESET=1

# Per-IP rate limit for POST routes, requests per minute (default: 60).
#CTRLZ_RATE_LIMIT_PER_MIN=60
